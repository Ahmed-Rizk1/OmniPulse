# ==============================================================================
# OmniPulse Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
# Supabase Postgres connection URL (connection pooler recommended for serverless/containers)
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Redis connection string (inside Docker Compose network: redis://redis:6379/0)
REDIS_URL=redis://redis:6379/0

# Runtime environment (development | production | test)
APP_ENV=development

# ------------------------------------------------------------------------------
# AI Models & Embeddings
# ------------------------------------------------------------------------------
# Google Gemini API key for generating 768-dimensional text embeddings
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIMENSIONS=768

# Groq API key for low-latency triage and resolution inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# Pipeline & Resolution Thresholds
# ------------------------------------------------------------------------------
# Minimum confidence required for Tier 1 triage automated resolution (0.0 - 1.0)
TRIAGE_CONFIDENCE_THRESHOLD=0.85

# Fallback Tier 2 LLM settings
TIER2_LLM_PROVIDER=groq
TIER2_MODEL=openai/gpt-oss-20b

# pgvector retrieval parameters
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.60

# Semantic cache parameters
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# Frontend / Client Auth (Supabase)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
